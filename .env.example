# Public analytics / ad settings used at build time.
# Set these in your deployment environment before running `next build`.

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ADSENSE_PUB_ID=

# Optional: connect the /deals email signup to a webhook destination.
# Example destinations: Zapier Catch Hook, Make webhook, custom API endpoint.
DEALS_ALERTS_WEBHOOK_URL=
DEALS_ALERTS_WEBHOOK_SECRET=
